# Copy to .env for local development. .env is git-ignored; never put real
# secrets in this example file. Values below are the built-in defaults unless
# noted.

# development | test | production
APP_ENV=development

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logging: LOG_LEVEL = debug | info | warn | error, LOG_FORMAT = json | text
LOG_LEVEL=info
LOG_FORMAT=text

# Credential issuer
ISSUER_ID=did:example:issuer-dev
# Generate with: go run ./cmd/issuerkeygen   (then paste the seed into your .env)
# If empty (non-production only) an ephemeral key is generated at startup, so
# credentials stop verifying after a restart. Required in production.
ISSUER_SIGNING_KEY_SEED=
CREDENTIAL_TTL=720h

# Simulated KYC + issuance endpoints. Defaults to true outside production;
# the process refuses to start with this enabled in production.
KYC_SIMULATION_ENABLED=true
