# Copy to .env for local development. .env is git-ignored; never put real
# secrets in this example file. Values below are the built-in defaults unless
# noted.

# development | test | production
APP_ENV=development

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logging: LOG_LEVEL = debug | info | warn | error, LOG_FORMAT = json | text
LOG_LEVEL=info
LOG_FORMAT=text

# Credential issuer
ISSUER_ID=did:example:issuer-dev
# Generate with: go run ./cmd/issuerkeygen   (then paste the seed into your .env)
# If empty (non-production only) an ephemeral key is generated at startup, so
# credentials stop verifying after a restart. Required in production.
ISSUER_SIGNING_KEY_SEED=
CREDENTIAL_TTL=720h

# Simulated approval + issuance endpoints, standing in for an issuer's real
# approval process (a KYC check, a ticket purchase, ...). Defaults to true
# outside production; the process refuses to start with this enabled in production.
APPROVAL_SIMULATION_ENABLED=true

# Solana registry. Leave SOLANA_RPC_URL empty to verify credentials off-chain
# only (non-production). Required in production.
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
# confirmed | finalized
SOLANA_COMMITMENT=confirmed
# Paths to solana-keygen JSON keypairs. Secrets: keep them outside the repo.
# The registry authority administers issuers; the issuer authority registers and
# revokes this issuer's credentials. Verification-only processes need neither.
SOLANA_REGISTRY_AUTHORITY_KEYPAIR=
SOLANA_ISSUER_AUTHORITY_KEYPAIR=
SOLANA_REQUEST_TIMEOUT=10s
SOLANA_TX_TIMEOUT=30s
# Dev/test only: create the registry and register this issuer at startup.
# Requires both keypairs and a fixed ISSUER_SIGNING_KEY_SEED. Refused in production.
SOLANA_BOOTSTRAP=false
